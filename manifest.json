{
  "id": "com.yaz.zotero",
  "name": "Zotero",
  "version": "0.2.0",
  "minAppVersion": "0.2.0",
  "author": "yaz",
  "description": "Cite from your Zotero library, and quote the passages you highlighted.",
  "icon": "◉",
  "repository": "https://github.com/texyaz/yaz-zotero",
  "capabilities": [
    {
      "kind": "zotero"
    },
    {
      "kind": "fs-project"
    }
  ],
  "provides": {
    "tools": [
      {
        "name": "search_library",
        "descriptionKey": "zotero-tool-search-library"
      },
      {
        "name": "list_highlights",
        "descriptionKey": "zotero-tool-list-highlights"
      },
      {
        "name": "add_to_bibliography",
        "descriptionKey": "zotero-tool-add-to-bibliography",
        "writes": true
      }
    ]
  },
  "updates": {
    "source": "github",
    "repository": "texyaz/yaz-zotero",
    "channel": "release"
  }
}
